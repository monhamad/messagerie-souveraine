{
	admin off
	auto_https disable_redirects
}

{$PUBLIC_HOST} {
	# Autorité de certification interne : aucun Let's Encrypt, aucun service tiers.
	tls internal

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
		-Server
	}

	# API Matrix uniquement ; l'API d'administration n'est jamais exposée ici.
	@matrix path /_matrix/* /_synapse/client/*
	reverse_proxy @matrix synapse:8008

	reverse_proxy element:80
}
