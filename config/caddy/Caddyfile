{
	admin off
	auto_https disable_redirects
}

{$PUBLIC_HOST} {
	# Autorité de certification interne : aucun Let's Encrypt, aucun service tiers.
	tls internal

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Keycloak : page de connexion (mot de passe + code TOTP).
	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	# API Matrix uniquement ; l'API d'administration de Synapse n'est jamais exposée ici.
	@matrix path /_matrix/* /_synapse/client/*
	handle @matrix {
		reverse_proxy synapse:8008
	}

	# Tout le reste : interface web Element.
	handle {
		reverse_proxy element:80
	}
}
