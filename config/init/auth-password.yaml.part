# --- Mode de REPLI (AUTH_MODE=password) : mot de passe local, SANS second facteur ---
# À n'utiliser que si Keycloak est indisponible. À déclarer comme tel.
password_config:
  enabled: true
  policy:
    enabled: true
    minimum_length: 12
    require_digit: true
    require_lowercase: true
    require_uppercase: true
    require_symbol: true
