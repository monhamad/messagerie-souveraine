# Facultatif : sans fichier .env, les valeurs par défaut conviennent à une démo sur https://localhost
# ATTENTION : SERVER_NAME ne peut plus changer après le premier démarrage.
SERVER_NAME=localhost
PUBLIC_HOST=localhost
PUBLIC_URL=https://localhost
HTTPS_PORT=443
HTTP_PORT=80
# Si HTTPS_PORT n'est pas 443, adapter PUBLIC_URL (ex. https://localhost:8443)
# ET config/element/config.json (base_url).

# Authentification : oidc (défaut, Keycloak + second facteur TOTP) ou password (REPLI sans 2FA).
# Changer de mode impose de recréer la pile : docker compose down -v && docker compose up -d
AUTH_MODE=oidc

# Mot de passe de l'administrateur Keycloak (la valeur par défaut est une valeur de démonstration).
# KEYCLOAK_ADMIN_PASSWORD=
